{
  "name": "phangduang-archeep",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ผังดวงอาชีพ — แบบสำรวจความสนใจด้านเทคโนโลยีและอาชีพดิจิทัล เลือกคำตอบด้วยการชูนิ้วหน้ากล้อง เล่นออฟไลน์ได้",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node build/make-sw.mjs",
    "start": "next start",
    "calibrate": "node build/calibrate.mjs",
    "icons": "node build/fetch-icons.mjs",
    "verify": "node build/check-balance.mjs && node build/test-fingers.mjs",
    "check": "npm run build && npm run verify",
    "manual": "node build/make-manual.mjs",
    "qr": "node build/make-qr.mjs",
    "shots": "node build/shoot-app.mjs desktop && node build/shoot-app.mjs mobile && node build/shoot-app.mjs small"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.9.0",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  }
}